{
  "name": "legible",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmduke/legible.git"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "scan": "tsx src/cli.ts",
    "artifacts:setup": "tsx src/scripts/setup-r2-artifacts.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "better-auth": "^1.6.25",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^174.0.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "robots-parser": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
