# Postgres (docker-compose exposes 5433 to avoid clashing with a local postgres)
DATABASE_URL=postgres://legible:legible@localhost:5433/legible

# better-auth
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (needs Search Console API enabled in the GCP project).
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chrome UX Report API key (optional; free — enable "Chrome UX Report API" in
# any GCP project). Without it, Core Web Vitals field-data checks are skipped.
CRUX_API_KEY=

# --- Public HTML reports (Cloudflare R2) ------------------------------------
# Optional. Without these, `--format html` writes to stdout instead of
# publishing. See README "Publishing HTML reports".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_PUBLIC_URL=

# Or set only an R2 API token (Admin Read & Write) with the bucket vars above;
# the S3 keys are derived from it and `pnpm artifacts:setup` enables r2.dev.
CLOUDFLARE_API_TOKEN=

# Stripe Projects deployments: `stripe projects env --pull` writes
# LEGIBLE_ASSETS_* vars instead. Set this to read a different resource prefix.
# ARTIFACTS_R2_RESOURCE=legible-assets
