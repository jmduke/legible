{
  "version": 1,
  "providers": {
    "cloudflare": {
      "name": "Cloudflare"
    },
    "render": {
      "name": "Render"
    }
  },
  "resources": {
    "cloudflare-plan": {
      "name": "cloudflare-plan",
      "providerName": "Cloudflare",
      "serviceId": "workers:free"
    },
    "cloudflare-workers": {
      "name": "cloudflare-workers",
      "providerName": "Cloudflare",
      "serviceId": "workers"
    },
    "legible": {
      "name": "legible",
      "providerName": "Cloudflare",
      "serviceId": "r2:bucket"
    },
    "legible-assets": {
      "name": "legible-assets",
      "providerName": "Cloudflare",
      "serviceId": "r2:bucket"
    }
  },
  "environments": {
    "default": {
      "output": ".env",
      "resources": [
        {
          "resourceName": "cloudflare-plan"
        },
        {
          "resourceName": "cloudflare-workers"
        },
        {
          "resourceName": "legible"
        },
        {
          "resourceName": "legible-assets"
        }
      ],
      "variables": [
        {
          "variableName": "cloudflare-api-token",
          "envKey": "CLOUDFLARE_API_TOKEN"
        },
        {
          "variableName": "cloudflare-public-url",
          "envKey": "CLOUDFLARE_PUBLIC_URL"
        }
      ]
    }
  },
  "variables": {
    "cloudflare-api-token": {
      "name": "cloudflare-api-token",
      "backendId": "fprjvar_61VAUqTBte7qMendJ16On4Xy7ZSQd2BSUS5VFMU80JQO"
    },
    "cloudflare-public-url": {
      "name": "cloudflare-public-url",
      "backendId": "fprjvar_61VAUr7CpF4TU0Pzx16On4Xy7ZSQd2BSUS5VFMU80X5s"
    }
  }
}
